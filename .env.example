# ==========================================
# Safarchin Travel Crawler - Environment Config
# ==========================================

# Server & Application Configuration
# PORT: Configurable application port (Docker Compose and Uvicorn bind to this port)
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=safarchin
POSTGRES_PASSWORD=safarchin_secret_change_me
POSTGRES_DB=safarchin_crawler
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If running via Docker Compose, the database service is reachable at 'db:5432'
DATABASE_URL=postgresql+asyncpg://safarchin:safarchin_secret_change_me@localhost:5432/safarchin_crawler

# Redis Configuration (Result Caching & Sliding-Window Rate Limiting)
# If running via Docker Compose, Redis is reachable at 'redis:6379/0'
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=600

# Security & API Key Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_super_secret_key_for_production
API_KEY_PREFIX=sc_
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_DAILY_QUOTA=1000

# Fuel Stations (OpenStreetMap corridor search along a route)
# The public OSRM demo endpoint is fine for development but has no availability
# guarantee. For production, run your own OSRM instance and point this at it.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Corridor half-width in metres, and the maximum a caller may request
FUEL_CORRIDOR_RADIUS_M=1000
FUEL_CORRIDOR_MAX_RADIUS_M=10000
FUEL_ROUTE_CACHE_TTL_SECONDS=86400

# Crawler Settings
CRAWLER_DEFAULT_TIMEOUT=15.0
CRAWLER_MAX_CONCURRENCY=5
USER_AGENT_MODE=desktop

# Provider Access Tokens (Optional here; can also be managed via CLI token pool)
# Format: Bearer <jwt_or_api_token>
JAJIGA_TOKEN=
